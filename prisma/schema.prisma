generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TodoEntity {
  id        String   @id @default(uuid())
  title     String
  link      String?
  completed Boolean  @default(false)
  order     Int?     @map("order_number")

  @@map("todos")
}
